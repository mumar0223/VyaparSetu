# PostgreSQL / Neon Database Connection
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require"

# UploadThing Token for media & assets
UPLOADTHING_TOKEN=""

# OpenAI / OpenAI-Compatible LLM Gateway (AWS Bedrock Mantle, OpenAI, OpenRouter, etc.)
OPENAI_API_KEY="your-api-key-here"
OPENAI_BASE_URL="https://bedrock-mantle.us-east-1.api.aws/v1"
OPENAI_MODEL="deepseek.v3.2"

# Vertex AI Live voice agent (service-account credentials remain server-side)
GOOGLE_VERTEX_PROJECT="your-gcp-project-id"
GOOGLE_VERTEX_LOCATION="global"
GOOGLE_CLIENT_EMAIL="voice-agent@your-gcp-project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
LIVE_VOICE_MODEL="gemini-live-2.5-flash"
LIVE_VOICE_NAME="Puck"
