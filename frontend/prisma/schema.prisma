generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String
  role               String          @default("USER")
  permissions        String[]        @default([])
  mustChangePassword Boolean         @default(false)
  isActive           Boolean         @default(true)
  lastLoginAt        DateTime?
  avatar             String?
  auditLogs          AuditLog[]      @relation("UserAuditLogs")
  sessions           Session[]       @relation("UserSessions")
  conversations      Conversation[]  @relation("UserConversations")
  businesses         Business[]
  settings           Settings?
  privacyConsent     PrivacyConsent?
  notifications      Notification[]
  passkeys           Passkey[]       @relation("UserPasskeys")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Conversation {
  id        String                @id @default(cuid())
  title     String                @default("New Conversation")
  pinned    Boolean               @default(false)
  userId    String
  user      User                  @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([userId])
  @@index([pinned])
  @@index([updatedAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant" | "system"
  content        String       @db.Text
  thinking       String?      @db.Text
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Business {
  id                 String   @id @default(uuid())
  ownerId            String
  businessName       String
  businessType       String?
  industry           String?
  category           String?
  description        String?
  registrationNumber String?
  taxNumber          String?
  address            String?
  city               String?
  state              String?
  country            String?
  pincode            String?
  numberOfEmployees  Int?
  annualRevenue      Float?
  monthlyRevenue     Float?
  monthlyExpenses    Float?
  businessGoals      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  expenses     Expense[]
  savingGoals  SavingGoal[]
  budgets      Budget[]
  debts        Debt[]
  milestones   BusinessMilestone[]
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT_PAYMENT
  SAVING
  OTHER
}

model Transaction {
  id          String          @id @default(uuid())
  businessId  String
  type        TransactionType
  amount      Float
  date        DateTime
  category    String?
  description String?
  referenceId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String    @id @default(uuid())
  businessId    String
  category      String
  amount        Float
  date          DateTime
  vendor        String?
  description   String?
  paymentMethod String?
  recurring     Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SavingGoal {
  id           String    @id @default(uuid())
  businessId   String
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  targetDate   DateTime?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contributions SavingContribution[]
}

model SavingContribution {
  id           String   @id @default(uuid())
  savingGoalId String
  amount       Float
  date         DateTime @default(now())
  notes        String?

  savingGoal SavingGoal @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
}

model Budget {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  period      String
  startDate   DateTime
  endDate     DateTime
  totalAmount Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    BudgetItem[]
}

model BudgetItem {
  id              String @id @default(uuid())
  budgetId        String
  category        String
  allocatedAmount Float

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

enum DebtType {
  TERM_LOAN
  WORKING_CAPITAL
  EQUIPMENT_FINANCING
  CREDIT_CARD
  OTHER
}

model Debt {
  id                String    @id @default(uuid())
  businessId        String
  type              DebtType
  lender            String
  amountOutStanding Float
  totalAmount       Float
  interestRate      Float?
  nextPaymentDate   DateTime?
  emiAmount         Float?
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PrivacyConsent {
  id              String   @id @default(uuid())
  userId          String   @unique
  dataSharing     Boolean  @default(false)
  marketingEmails Boolean  @default(false)
  termsAccepted   Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id          String   @id @default(uuid())
  userId      String   @unique
  currency    String   @default("INR")
  language    String   @default("en")
  theme       String   @default("light")
  emailAlerts Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessMilestone {
  id          String   @id @default(uuid())
  businessId  String
  title       String
  description String?
  isAchieved  Boolean  @default(false)
  date        DateTime
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model GovernmentSchemeMatch {
  id               String   @id @default(uuid())
  userId           String   @unique
  schemes          Json
  summary          String?  @db.Text
  totalSubsidies   String?
  district         String?
  state            String?
  lastEvaluatedAt  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DistrictBusinessPrediction {
  id               String   @id @default(uuid())
  userId           String   @unique
  district         String
  state            String
  budget           Float
  category         String?
  riskLevel        String?
  predictions      Json
  districtSummary  String?  @db.Text
  liveMandiInsight String?  @db.Text
  mandiRecords     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SwotMarketAnalysis {
  id         String   @id @default(uuid())
  userId     String   @unique
  district   String
  state      String
  radiusKm   Float
  score      Float
  swotData   Json
  actionPlan Json?
  dataSource String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StrategicActionPlaybook {
  id                String   @id @default(uuid())
  userId            String   @unique
  playbooks         Json
  enterpriseSummary String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model OndcMarketIntelligence {
  id        String   @id @default(uuid())
  userId    String   @unique
  category  String
  location  String?
  data      Json
  summary   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompetitorMarketIntelligence {
  id        String   @id @default(uuid())
  userId    String   @unique
  category  String
  location  String?
  data      Json
  summary   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserPasskeys", fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  deviceName   String?
  transports   String[]  @default([])
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@index([credentialId])
}


