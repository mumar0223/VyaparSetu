generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  businesses         Business[]
  settings           Settings?
  privacyConsent     PrivacyConsent?
  notifications      Notification[]
}

model Business {
  id                 String   @id @default(uuid())
  ownerId            String
  businessName       String
  businessType       String?
  industry           String?
  category           String?
  description        String?
  registrationNumber String?
  taxNumber          String?
  address            String?
  city               String?
  state              String?
  country            String?
  pincode            String?
  numberOfEmployees  Int?
  annualRevenue      Float?
  monthlyRevenue     Float?
  monthlyExpenses    Float?
  businessGoals      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  expenses           Expense[]
  savingGoals        SavingGoal[]
  budgets            Budget[]
  debts              Debt[]
  milestones         BusinessMilestone[]
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT_PAYMENT
  SAVING
  OTHER
}

model Transaction {
  id          String   @id @default(uuid())
  businessId  String
  type        TransactionType
  amount      Float
  date        DateTime
  category    String?
  description String?
  referenceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String   @id @default(uuid())
  businessId    String
  category      String
  amount        Float
  date          DateTime
  vendor        String?
  description   String?
  paymentMethod String?
  recurring     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SavingGoal {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  targetAmount Float
  savedAmount  Float    @default(0)
  targetDate   DateTime?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contributions SavingContribution[]
}

model SavingContribution {
  id           String   @id @default(uuid())
  savingGoalId String
  amount       Float
  date         DateTime @default(now())
  notes        String?
  
  savingGoal   SavingGoal @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
}

model Budget {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  period      String
  startDate   DateTime
  endDate     DateTime
  totalAmount Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       BudgetItem[]
}

model BudgetItem {
  id             String   @id @default(uuid())
  budgetId       String
  category       String
  allocatedAmount Float

  budget         Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

enum DebtType {
  TERM_LOAN
  WORKING_CAPITAL
  EQUIPMENT_FINANCING
  CREDIT_CARD
  OTHER
}

model Debt {
  id                String   @id @default(uuid())
  businessId        String
  type              DebtType
  lender            String
  amountOutStanding Float
  totalAmount       Float
  interestRate      Float?
  nextPaymentDate   DateTime?
  emiAmount         Float?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PrivacyConsent {
  id              String   @id @default(uuid())
  userId          String   @unique
  dataSharing     Boolean  @default(false)
  marketingEmails Boolean  @default(false)
  termsAccepted   Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id              String   @id @default(uuid())
  userId          String   @unique
  currency        String   @default("INR")
  language        String   @default("en")
  theme           String   @default("light")
  emailAlerts     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessMilestone {
  id          String   @id @default(uuid())
  businessId  String
  title       String
  description String?
  isAchieved  Boolean  @default(false)
  date        DateTime
  createdAt   DateTime @default(now())
  
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
